---
import Base from "../../layouts/Base.astro";
import { essays, fieldNotes, modelcraft } from "../../data/maps";
import { formatEssayDate } from "../../data/essays";
import { site } from "../../data/site";

const investigations = essays.filter((item) => item.kind !== "Archive");
const archive = essays.filter((item) => item.kind === "Archive");
---

<Base
  title="Writing"
  description="Investigations on inference systems, GPU engineering, and the cost of a token."
>
  <section class="page">
    <p class="label">Writing</p>
    <h1>Investigations, then tools.</h1>
    <p class="lede">
      Investigations are the long pieces I write here. For these, I often start with a
      question, define the terms, make a claim, and look at what would break it.
    </p>
    <p class="lede">
      Archive is earlier work: evals, AutoML, MLOps, games. ModelCraft is the newsletter and podcast.
      Field notes are the LinkedIn posts. Those two live on their own sites. I listed them
      here so you can find the source.
    </p>
  </section>

  <section class="section ddl-toolbar">
    <p class="label">View</p>
    <div class="ddl-filters" role="group" aria-label="Filter writing" data-filters="kind">
      <button type="button" class="ddl-filter" data-kind="all" aria-pressed="true">All</button>
      <button type="button" class="ddl-filter" data-kind="investigations" aria-pressed="false">Investigations</button>
      <button type="button" class="ddl-filter" data-kind="archive" aria-pressed="false">Archive</button>
      <button type="button" class="ddl-filter" data-kind="modelcraft" aria-pressed="false">ModelCraft: Substack & Podcast</button>
      <button type="button" class="ddl-filter" data-kind="field-notes" aria-pressed="false">LinkedIn: Field Notes</button>
    </div>
  </section>

  <section class="section ddl-section" id="investigations" data-kind="investigations">
    <div class="section-head">
      <h2>Investigations</h2>
    </div>
    <ul class="list">
      {
        investigations.map((item) => (
          <li>
            <span class="meta">{formatEssayDate(item.date)}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section ddl-section" id="archive" data-kind="archive">
    <div class="section-head">
      <h2>Archive</h2>
    </div>
    <ul class="list">
      {
        archive.map((item) => (
          <li>
            <span class="meta">{formatEssayDate(item.date)}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section ddl-section" id="modelcraft" data-kind="modelcraft">
    <div class="section-head">
      <h2>ModelCraft: Substack & Podcast</h2>
      <a class="label" href={site.links.modelcraft}>All issues →</a>
    </div>
    <ul class="list">
      {
        modelcraft.map((item) => (
          <li>
            <span class="meta">{item.kind}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.date} · {item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section ddl-section" id="field-notes" data-kind="field-notes">
    <div class="section-head">
      <h2>LinkedIn: Field Notes</h2>
      <a class="label" href={site.links.linkedin}>LinkedIn · 50 →</a>
    </div>
    <ul class="list">
      {
        fieldNotes.map((item) => (
          <li>
            <span class="meta">{String(item.rank).padStart(2, "0")}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

</Base>

<script>
  const allowed = new Set(["all", "investigations", "archive", "modelcraft", "field-notes"]);
  const hashKind = window.location.hash.replace("#", "");
  let kind = allowed.has(hashKind) ? hashKind : "all";

  function apply() {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-filters='kind'] .ddl-filter")) {
      button.setAttribute("aria-pressed", String(button.dataset.kind === kind));
    }
    for (const section of document.querySelectorAll<HTMLElement>(".ddl-section")) {
      section.hidden = kind !== "all" && section.dataset.kind !== kind;
    }
  }

  apply();

  document.querySelector("[data-filters='kind']")?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".ddl-filter");
    if (!button?.dataset.kind) return;
    kind = button.dataset.kind;
    history.replaceState(null, "", kind === "all" ? "/writing/" : `/writing/#${kind}`);
    apply();
  });

  window.addEventListener("hashchange", () => {
    const next = window.location.hash.replace("#", "");
    kind = allowed.has(next) ? next : "all";
    apply();
  });
</script>
