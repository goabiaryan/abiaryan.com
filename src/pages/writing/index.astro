---
import Base from "../../layouts/Base.astro";
import { essays, fieldNotes, modelcraft } from "../../data/maps";
import { site } from "../../data/site";

const investigations = essays.filter((item) => item.kind !== "Archive");
const archive = essays.filter((item) => item.kind === "Archive");
---

<Base
  title="Writing"
  description="Investigations on inference systems, GPU engineering, and the cost of a token."
>
  <section class="page">
    <p class="label">Writing</p>
    <h1>Investigations, then tools.</h1>
    <p class="lede">
      Investigations are the long pieces I write here. I start with a question, define the
      terms, make a claim, and say what would break it.
    </p>
    <p class="lede">
      Archive is earlier work: evals, AutoML, MLOps, games. ModelCraft is the newsletter and podcast.
      Field notes are the LinkedIn posts. Those two live on their own sites. I listed them
      here so you can find the source.
    </p>
    <p class="home-links">
      <a href="#investigations">Investigations</a>
      <a href="#archive">Archive</a>
      <a href="#modelcraft">ModelCraft</a>
      <a href="#field-notes">Field notes</a>
    </p>
  </section>

  <section class="section" id="investigations">
    <div class="section-head">
      <h2>Investigations</h2>
    </div>
    <ul class="list">
      {
        investigations.map((item) => (
          <li>
            <span class="meta">{item.kind ?? item.date.slice(0, 4)}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="archive">
    <div class="section-head">
      <h2>Archive</h2>
    </div>
    <ul class="list">
      {
        archive.map((item) => (
          <li>
            <span class="meta">{item.date.slice(0, 4)}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="modelcraft">
    <div class="section-head">
      <h2>ModelCraft</h2>
      <a class="label" href={site.links.modelcraft}>All issues →</a>
    </div>
    <ul class="list">
      {
        modelcraft.map((item) => (
          <li>
            <span class="meta">{item.kind}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.date} · {item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="field-notes">
    <div class="section-head">
      <h2>Field notes</h2>
      <a class="label" href={site.links.linkedin}>LinkedIn · 50 →</a>
    </div>
    <ul class="list">
      {
        fieldNotes.map((item) => (
          <li>
            <span class="meta">{String(item.rank).padStart(2, "0")}</span>
            <div>
              <a class="title" href={item.href}>{item.title}</a>
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

</Base>
