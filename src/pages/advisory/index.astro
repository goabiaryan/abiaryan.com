---
import Base from "../../layouts/Base.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import { site } from "../../data/site";
import { offers, capacity } from "../../data/advisory";
---

<Base
  title="Advisory"
  description="A second set of eyes on production inference. Architecture and SLO audit, then one strategic retainer."
>
  <section class="sell">
    <p class="label">Advisory</p>
    <h1>A second set of eyes on the serving stack.</h1>
    <p class="lede">
      For teams with scaled inference workloads where every millisecond and dollar per
      million tokens counts, I audit what is actually happening across your cluster,
      identify the recoverable spend hiding behind gross utilization, and advise the
      technical decisions that change your unit economics. Your team owns the execution.
    </p>
    <p class="form-note">{capacity} Not a hire. Not a <a href={site.links.joule}>Joule</a> service.</p>
  </section>

  <section class="sell-offers">
    <div class="grid-2">
      {
        offers.map((item) => (
          <article class="offer-card">
            <p class="label">{item.label}</p>
            <h2>{item.title}</h2>
            <p class="price">{item.price}</p>
            <p>{item.summary}</p>
            <p class="form-note">{item.priceNote}</p>
            {item.finePrint && <p class="form-note">{item.finePrint}</p>}
            <ul class="include">
              {item.items.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            <div class="cta-row">
              <a class="btn" href={`/advisory/?offer=${item.id}#pay`}>
                {item.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="sell sell-proof">
    <p class="proof">
      A decade building production ML. Author of <a href={site.links.llmops}>LLMOps</a>
      (O'Reilly).
      <a href="/books/">GPU Engineering: AI Inference and System Design</a> (Packt) is almost finished,
      launch is end of 2026 or early 2027.
      Invited Expert and Faculty Member on AI Inferencing for
      <a href={site.links.academy}>Andreessen Horowitz Academy (The Academy SF)</a>.
    </p>
  </section>

  <section class="sell-pay" id="pay">
    <div class="sell-pay-copy">
      <p class="label">Checkout</p>
      <h2>Pay. Then we schedule.</h2>
      <p class="form-note">
        Payment unlocks the calendar and the intake. I take only 2 clients a month.
      </p>
    </div>
    <InquiryForm />
  </section>
</Base>
