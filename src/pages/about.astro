---
import Base from "../layouts/Base.astro";
import Stack from "../components/Stack.astro";
import { site, research } from "../data/site";
import { papers } from "../data/papers";
import { education, theses } from "../data/education";
import { aboutJsonLd } from "../data/identity";
import { volunteering } from "../data/speaking";
---

<Base
  title="About"
  description="Abi Aryan: AI Infrastructure Engineer, Joule founder, Maven instructor, Invited Expert and Faculty Member on AI Inferencing at Andreessen Horowitz Academy. Doctoral research in HPC distributed systems. Master's theses at NOVA IMS and LSE. The stack I teach: vLLM, SGLang, KV cache, CUDA, Kubernetes."
  jsonLd={aboutJsonLd}
>
  <section class="about-split">
    <div class="about-copy">
    <p class="label">About</p>
    <h1>Abi Aryan</h1>
    <p class="lede">
      I am an AI Infrastructure Engineer building inference systems for data centers,
      neoclouds, and hyperscalers. I founded
      <a href={site.links.joule}>Joule</a>, an inference power economics engine connecting
      physical GPU energy to token throughput and SLO goodput.
    </p>
    <div class="prose">
    <p>
      I have spent over a decade building production ML systems and work across the
      inference stack:
      runtimes, distributed systems, GPUs, compilers, networking, and cluster efficiency.
      I architect infrastructure for serving systems built on TensorRT-LLM, TorchDynamo,
      SGLang, and vLLM, with a focus on
      high-concurrency inference at scale, from requests and tokens
      to GPUs, network fabric, power, cooling, and data-center capacity.
    </p>
    <p>
      I am a doctoral researcher in HPC distributed systems, studying SLO-aware
      inference optimization and hardware-aware compiler design for supercomputers, and
      developing a digital twin for LLM inference that lets operators
      manage energy while protecting latency SLOs.
    </p>
    <p>
      I build, measure, research, write about, and teach these systems. I am an
      <em>Invited Expert and Faculty Member on AI Inferencing for
      <a href={site.links.academy}>Andreessen Horowitz Academy (The Academy SF by a16z)</a></em>.
      I teach
      <a href={site.links.maven}>AI Inference Engineering &amp; Systems Design</a>
      and
      <a href={site.links.mavenIntro}>AI Inference for FDE and PM Roles</a>
      on Maven. Ex-students have been AI Infra Founders, Head of AI, AI engineers,
      Solutions Architects, Principal Engineers, SWEs from FAANG, National banks and
      Energy companies, from across 5 continents.
    </p>
    <p>
      I am the author of
      <em><a href={site.links.llmops}>LLMOps</a></em> (2025), translated into Korean,
      Japanese, Russian, and Simplified Chinese, and
      <em><a href={site.links.llmopsWhat}>What is LLMOps</a></em> (O'Reilly, 2024). My next
      book,
      <em><a href="/books/">GPU Engineering: AI Inference and System Design</a></em> (Packt),
      is nearing completion, with publication planned for late 2026 or early 2027. I write
      <a href={site.links.modelcraft}>ModelCraft</a> and review for NeurIPS, ACL, EMNLP,
      ICML, ICLR, TMLR, and AABI.
    </p>
    <p>
      Previously, I co-founded <a href={site.links.abide}>Abide</a>, a research lab focused
      on reflective intelligence and neuro-symbolic models for agents, where I contributed
      platform and observability solutions for agentic reasoning in LLMs. This work was
      presented at NeurIPS 2025. Abide is prior work;
      <a href={site.links.joule}>Joule</a> is the company I run today.
    </p>
    <p>
      A mathematician by training, I was a visiting research scholar at
      UCLA's Cognitive Systems Lab from 2018-19 under Dr.
      <a href={site.links.pearl}>Judea Pearl</a>, ACM 2012 Turing Award Winner, where my
      research spanned intelligence in agents, causal inference, AutoML, and multi-agent
      learning.
    </p>
    <p>
      For talks, see <a href="/speaking/">Speaking</a>. For audit and advisory work, see
      <a href="/advisory/">Advisory</a>.
    </p>
    </div>
    </div>
    <div class="about-aside">
      <Stack heading="The Infra Stack I Work Across" />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Doctoral work</h2>
    </div>
    <p class="lede" style="margin-bottom: 1.6rem">{site.doctorate.statement}</p>
    <div class="grid-3">
      {
        research.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Education</h2>
    </div>
    <ul class="list">
      {
        education.map((item) => (
          <li>
            <span class="meta">{item.year}</span>
            <div>
              {item.href ? (
                <a class="title" href={item.href}>{item.title}</a>
              ) : (
                <span class="title">{item.title}</span>
              )}
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Theses</h2>
    </div>
    <ul class="list">
      {
        theses.map((item) => (
          <li>
            <span class="meta">{item.year}</span>
            <div>
              {item.href ? (
                <a class="title" href={item.href}>{item.title}</a>
              ) : (
                <span class="title">{item.title}</span>
              )}
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Papers</h2>
    </div>
    <ul class="list">
      {
        papers.map((item) => (
          <li>
            <span class="meta">{item.year}</span>
            <div>
              {item.href ? (
                <a class="title" href={item.href}>{item.title}</a>
              ) : (
                <span class="title">{item.title}</span>
              )}
              <p class="note">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <details class="year" open>
      <summary>Reviewing and service</summary>
      {
        volunteering.map((item) => (
          <div class="talk">
            <div class="when">{item.when}</div>
            <div>
              {item.href ? <a href={item.href}>{item.what}</a> : item.what}
            </div>
          </div>
        ))
      }
    </details>
  </section>

  <section class="section media-block">
    <div class="section-head">
      <h2>Media</h2>
      <span class="label">October 2024</span>
    </div>
    <video class="media-clip" controls playsinline preload="metadata">
      <source src="/assets/billboard.mp4" type="video/mp4" />
    </video>
    <p>I was featured on the Times Square Billboard by <a href={site.links.topmate}>Topmate</a>.</p>
  </section>
</Base>
