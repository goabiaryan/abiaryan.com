---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { identityJsonLd } from "../data/identity";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = "/og.jpg?v=2",
  type = "website",
  jsonLd,
} = Astro.props;
const withName = title ? `${title} · ${site.name}` : site.title;
const pageTitle = withName.length <= 70 ? withName : title && title.length <= 70 ? title : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageAbs = new URL(image, site.url).href;
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const payloads = [...identityJsonLd, ...extra];
const isHome = Astro.url.pathname.replace(/\/+$/, "") === "";
const socialDescription =
  isHome || description === site.description
    ? "AI Infrastructure Engineer building inference systems for data centers, neoclouds, and hyperscalers."
    : description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM full index" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageAbs} />
    <meta property="og:image:secure_url" content={imageAbs} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageAbs} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    {
      payloads.map((payload) => (
        <script type="application/ld+json" set:html={JSON.stringify(payload)} />
      ))
    }
    <script is:inline define:vars={{ analytics: site.analytics }}>
      (function () {
        var ua = navigator.userAgent || "";
        if (
          navigator.webdriver ||
          /HeadlessChrome|PhantomJS|Playwright|Puppeteer/i.test(ua)
        ) {
          return;
        }
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + analytics;
        document.head.appendChild(s);
        gtag("js", new Date());
        gtag("config", analytics);
      })();
    </script>
  </head>
  <body class:list={[isHome && "page-home"]}>
    <div class="wrap">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (function () {
        var origin = location.origin;
        document.querySelectorAll("a[href]").forEach(function (link) {
          var href = link.getAttribute("href");
          if (!href || href.charAt(0) === "#" || href.charAt(0) === "/" || href.indexOf("mailto:") === 0 || href.indexOf("tel:") === 0) {
            return;
          }
          try {
            var url = new URL(href, origin);
            if (url.origin === origin) return;
            if (url.protocol !== "http:" && url.protocol !== "https:") return;
            link.target = "_blank";
            var rel = new Set((link.rel || "").split(/\s+/).filter(Boolean));
            rel.add("noopener");
            rel.add("noreferrer");
            link.rel = Array.from(rel).join(" ");
          } catch (err) {}
        });
      })();
    </script>
  </body>
</html>
