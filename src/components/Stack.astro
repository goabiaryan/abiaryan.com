---
import { stack } from "../data/site";

interface Props {
  compact?: boolean;
  heading?: string;
}

const { compact = false, heading = "The stack I teach" } = Astro.props;
---

<aside class:list={["stack", compact && "stack-compact"]} aria-label={heading}>
  <p class="label">{heading}</p>
  <ol>
    {
      stack.map((item, i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <span class="layer">{item.layer}</span>
            {
              !compact && (
                <ul class="chips">
                  {item.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              )
            }
          </div>
        </li>
      ))
    }
  </ol>
</aside>
