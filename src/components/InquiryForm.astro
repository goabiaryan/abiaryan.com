---
import { offers, focuses, type OfferId } from "../data/advisory";

interface Props {
  offer?: OfferId | "";
}

const { offer = "" } = Astro.props;
const selected = offers.find((item) => item.id === offer);
const pay = selected?.cta ?? "Pay";
---

<form class="form" method="POST" action="/api/checkout/">
  <label for="offer">Offer</label>
  <select id="offer" name="offer" required>
    <option value="" disabled selected={!offer}>Select an offer</option>
    {
      offers.map((item) => (
        <option value={item.id} selected={offer === item.id} data-cta={item.cta}>
          {item.title} · {item.price}
        </option>
      ))
    }
  </select>

  <label for="focus">Focus</label>
  <select id="focus" name="focus">
    <option value="not-sure">Not sure yet</option>
    {focuses.map((item) => <option value={item.id}>{item.title}</option>)}
    <option value="both">Both</option>
  </select>

  <label for="name">Name</label>
  <input id="name" name="name" type="text" required autocomplete="name" />

  <label for="email">Work email</label>
  <input id="email" name="email" type="email" required autocomplete="email" />

  <label for="company">Company</label>
  <input id="company" name="company" type="text" required autocomplete="organization" />

  <button type="submit" class="btn" id="pay-btn">{pay}</button>
</form>

<script>
  const params = new URLSearchParams(window.location.search);
  const select = document.getElementById("offer");
  const button = document.getElementById("pay-btn");
  const apply = () => {
    if (!(select instanceof HTMLSelectElement) || !button) return;
    const chosen = select.selectedOptions[0];
    const cta = chosen?.dataset.cta;
    if (cta) button.textContent = cta;
  };
  const fromQuery = params.get("offer");
  if (fromQuery && select instanceof HTMLSelectElement) {
    select.value = fromQuery;
  }
  select?.addEventListener("change", apply);
  apply();
</script>
